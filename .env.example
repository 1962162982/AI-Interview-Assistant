# ============================================================
# 模型路由 API Key（按模块独立命名，禁止硬编码进代码）
# 决策④：每个模块绑定独立模型——Key / Base URL 按模块独立填写，不同模块可指向不同供应商
# 使用方法：复制本文件为 .env，填入真实值；.env 已被 .gitignore 保护
# 参考 Base URL：DeepSeek = https://api.deepseek.com ；智谱 GLM = https://open.bigmodel.cn/api/paas/v4
# ============================================================

# --- 模块 A：简历诊断（deepseek-chat / DeepSeek-V3）---
RESUME_DIAGNOSIS_API_KEY=
RESUME_DIAGNOSIS_BASE_URL=

# --- 模块 B：JD 匹配（glm-4-air / GLM-4-Air）---
JD_MATCHING_API_KEY=
JD_MATCHING_BASE_URL=

# --- 模块 C：模拟面试（glm-4-flash / GLM-4-Flash 免费档）---
INTERVIEW_AGENT_API_KEY=
INTERVIEW_AGENT_BASE_URL=

# --- 模块 D：即时反馈（glm-4-plus / GLM-4-Plus，评分类用更强档位）---
EVALUATION_API_KEY=
EVALUATION_BASE_URL=

# --- 模块 D：交叉复核（deepseek-chat / DeepSeek-V3，须与 evaluation 使用不同模型）---
CROSS_REVIEW_API_KEY=
CROSS_REVIEW_BASE_URL=

# ============================================================
# 临时联调模式（可选，默认关闭）
# 2026-10-23 用户指示：先把所有模块都切到 DeepSeek 跑通，再恢复双供应商混用。
# 启用方式：取消下一行注释（.env 中设置），即改用全 DeepSeek 路由配置；
# 删除 / 注释后自动回到 backend/config/models.yaml（决策④ 双供应商）。
# MODELS_CONFIG_PATH=backend/config/models.deepseek.yaml
# ============================================================
